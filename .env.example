# Copy to .env and fill in. Never commit .env.
# Secrets and per-environment settings only. Pipeline defaults live in config.yaml.

# LLM provider keys. A provider without a key is skipped during failover.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: path to the pipeline config (defaults to ./config.yaml)
# HYBRID_RAG_CONFIG=config.yaml

# Optional: override any config.yaml value. Use the HYBRID_RAG_ prefix and "__" between levels.
# HYBRID_RAG_QDRANT__URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional: override the LLM settings from config.yaml (normally edit config.yaml instead).
# The value is JSON in single quotes: an ordered list, primary first, fallbacks after.
# HYBRID_RAG_LLM__ANSWER='[{"provider":"openai","model":"gpt-5"},{"provider":"anthropic","model":"claude-sonnet-5-5"}]'
# HYBRID_RAG_LLM__QUERY_REWRITE='[{"provider":"openai","model":"gpt-5-mini"},{"provider":"anthropic","model":"claude-haiku-5-5"}]'
# HYBRID_RAG_LLM__RETRY__MAX_ATTEMPTS=3

# Optional: LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hybrid-rag
